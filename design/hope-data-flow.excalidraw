{
  "type": "excalidraw",
  "version": 2,
  "source": "claude",
  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "id": "title", "type": "text", "x": 20, "y": 20, "width": 1900, "height": 75, "text": "HOPE Framework: current data flow", "fontSize": 28, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "subtitle", "type": "text", "x": 20, "y": 110, "width": 1900, "height": 80, "text": "Approved browser-only client. Deny-all rules released 2026-11-17. Legacy erasure, privileged IAM and provider retention are separate decisions.", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "browser-boundary", "type": "rectangle", "x": 20, "y": 200, "width": 1100, "height": 900, "strokeColor": "#495057", "backgroundColor": "transparent", "strokeStyle": "dashed", "strokeWidth": 2, "roughness": 0 },
    { "id": "browser-label", "type": "text", "x": 40, "y": 220, "width": 1000, "height": 50, "text": "Browser / origin-local state (shared profiles share storage)", "fontSize": 20, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "actions", "type": "rectangle", "x": 60, "y": 300, "width": 340, "height": 300, "strokeColor": "#1864ab", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "boundElements": [{ "type": "text", "id": "actions-text" }] },
    { "id": "actions-text", "type": "text", "containerId": "actions", "x": 80, "y": 330, "width": 300, "height": 200, "text": "Learner / teacher actions\nStories, game choices,\nwriting and scores\nHeld in page / Trail memory", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "storage", "type": "rectangle", "x": 580, "y": 300, "width": 480, "height": 300, "strokeColor": "#1864ab", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "boundElements": [{ "type": "text", "id": "storage-text" }] },
    { "id": "storage-text", "type": "text", "containerId": "storage", "x": 600, "y": 330, "width": 440, "height": 220, "text": "Browser-origin storage\nMetrics / grade preferences\nClassroom work / teacher comments\nNo new remote visitor ID\nClear metrics leaves classwork", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "dashboard", "type": "rectangle", "x": 580, "y": 700, "width": 480, "height": 220, "strokeColor": "#1864ab", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "boundElements": [{ "type": "text", "id": "dashboard-text" }] },
    { "id": "dashboard-text", "type": "text", "containerId": "dashboard", "x": 600, "y": 720, "width": 440, "height": 180, "text": "Browser metrics dashboard\nLocal counters and histories only\nNo cross-visitor fetch/aggregation\nJSON export remains local", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "outputs", "type": "rectangle", "x": 60, "y": 700, "width": 340, "height": 170, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "boundElements": [{ "type": "text", "id": "outputs-text" }] },
    { "id": "outputs-text", "type": "text", "containerId": "outputs", "x": 80, "y": 730, "width": 300, "height": 110, "text": "User-triggered outputs\nLocal JSON download\nPage print workflow", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "firestore", "type": "rectangle", "x": 1320, "y": 280, "width": 600, "height": 300, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "boundElements": [{ "type": "text", "id": "firestore-text" }] },
    { "id": "firestore-text", "type": "text", "containerId": "firestore", "x": 1340, "y": 310, "width": 560, "height": 220, "text": "Legacy Firestore: /visitors/{id}\nCurrent client has no connection\nRules deny all client access\nRules released 2026-11-17\nDeletion needs privileged approval", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "providers", "type": "rectangle", "x": 1320, "y": 700, "width": 600, "height": 280, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "boundElements": [{ "type": "text", "id": "providers-text" }] },
    { "id": "providers-text", "type": "text", "containerId": "providers", "x": 1340, "y": 720, "width": 560, "height": 230, "text": "Other outbound services\nGuided paragraphs -> MyMemory\nActivity/Guided text -> speech engine*\nFeedback + metadata -> GitHub\nFonts / external resource links", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "public-clients", "type": "rectangle", "x": 1320, "y": 1160, "width": 600, "height": 180, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "boundElements": [{ "type": "text", "id": "public-text" }] },
    { "id": "public-text", "type": "text", "containerId": "public-clients", "x": 1340, "y": 1180, "width": 560, "height": 130, "text": "Other clients / legacy clients\nDenied by updated client rules\nRules released 2026-11-17", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "track-store", "type": "arrow", "x": 400, "y": 430, "width": 180, "height": 0, "points": [[0, 0], [180, 0]], "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0, "endArrowhead": "arrow" },
    { "id": "track-label", "type": "text", "x": 410, "y": 350, "width": 160, "height": 70, "text": "events /\npublish", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "local-fallback", "type": "arrow", "x": 820, "y": 600, "width": 0, "height": 100, "points": [[0, 0], [0, 100]], "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0, "endArrowhead": "arrow" },
    { "id": "fallback-label", "type": "text", "x": 840, "y": 630, "width": 200, "height": 40, "text": "local fallback", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "output-arrow", "type": "arrow", "x": 230, "y": 600, "width": 0, "height": 100, "points": [[0, 0], [0, 100]], "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0, "endArrowhead": "arrow" },
    { "id": "outbound", "type": "arrow", "x": 400, "y": 520, "width": 920, "height": 520, "points": [[0, 0], [40, 0], [40, 520], [850, 520], [850, 320], [920, 320]], "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0, "endArrowhead": "arrow" },
    { "id": "outbound-label", "type": "text", "x": 470, "y": 950, "width": 620, "height": 80, "text": "Text transfers on user actions;\nexternal asset requests at page load", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "public-arrow", "type": "arrow", "x": 1920, "y": 430, "width": 40, "height": 820, "points": [[0, 0], [40, 0], [40, 820], [0, 820]], "strokeColor": "#e67700", "strokeStyle": "dashed", "strokeWidth": 2, "roughness": 0, "startArrowhead": "arrow", "endArrowhead": "arrow" },
    { "id": "public-label", "type": "text", "x": 1980, "y": 610, "width": 240, "height": 160, "text": "DENIED by client policy\nRules release confirmed\nNo records queried", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "notes", "type": "text", "x": 20, "y": 1170, "width": 1150, "height": 160, "text": "* Speech may be remote depending on voice/browser.\nCurrent client: no Firebase SDK, reads, writes or sync timers.\nBrowser reset does not delete legacy cloud records.\nSee PRIVACY_REVIEW.md for fields, limits and approval steps.", "fontSize": 16, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" }
  ]
}
